{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["app/**", "Dockerfile", "pyproject.toml"]
  },
  "deploy": {
    "startCommand": "celery -A app.workers.celery_app:celery_app worker --loglevel=INFO --concurrency=2 --queues=classification.default,classification.dead_letter",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60
  }
}
