# Application
ENVIRONMENT=production
APP_NAME=AI Support Ticket Classifier
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
HTTP_PORT=8080

# Compose-managed PostgreSQL credentials. Replace this value before startup.
POSTGRES_DB=ticket_classifier
POSTGRES_USER=ticket_classifier
POSTGRES_PASSWORD=change-me-before-deployment

# Infrastructure
# Used for host-based development. Compose overrides service URLs with container DNS.
DATABASE_URL=postgresql+asyncpg://ticket_classifier:change-me-before-deployment@localhost:5432/ticket_classifier
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_MAX_RETRIES=3

# AI provider
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_ATTEMPTS=5
OPENAI_BACKOFF_BASE_SECONDS=0.5
OPENAI_BACKOFF_MAX_SECONDS=8
OPENAI_RETRY_AFTER_MAX_SECONDS=60
OPENAI_PRIMARY_INPUT_COST_PER_MILLION=2.00
OPENAI_PRIMARY_CACHED_INPUT_COST_PER_MILLION=0.50
OPENAI_PRIMARY_OUTPUT_COST_PER_MILLION=8.00
OPENAI_FALLBACK_INPUT_COST_PER_MILLION=0.40
OPENAI_FALLBACK_CACHED_INPUT_COST_PER_MILLION=0.10
OPENAI_FALLBACK_OUTPUT_COST_PER_MILLION=1.60

# HTTP security and admission control (JSON array for origins)
CORS_ALLOWED_ORIGINS=["https://support.example.com"]
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
TICKET_CACHE_TTL_SECONDS=300
TICKET_BATCH_MAX_SIZE=100
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
SHUTDOWN_TIMEOUT_SECONDS=10
SECRET_KEY=replace-with-an-independent-32-byte-random-secret
JWT_SECRET_KEY=replace-with-another-independent-32-byte-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=supportflow_access
AUTH_COOKIE_SECURE=true
