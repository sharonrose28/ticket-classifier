{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["app/**", "alembic/**", "scripts/**", "Dockerfile", "pyproject.toml"]
  },
  "deploy": {
    "preDeployCommand": ["alembic upgrade head"],
    "startCommand": "sh -c 'exec uvicorn app.main:app --host \"\" --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\"'",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 30,
    "drainingSeconds": 20
  }
}
